# Google API Key for PageSpeed Insights and Mobile-Friendly Test
# Get your API key from: https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_API_KEY=your_google_api_key_here

# Zapier Webhook URL for sending audit results and email capture
# Create a webhook in Zapier and paste the URL here
REACT_APP_ZAPIER_WEBHOOK=https://hooks.zapier.com/hooks/catch/your_webhook_url

# Booking/Consultation Link (optional)
# Link to your booking page or calendar (Calendly, etc.)
REACT_APP_BOOKING_LINK=https://calendly.com/your-link
